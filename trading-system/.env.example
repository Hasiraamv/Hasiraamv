# --- LLM (Qwen via any OpenAI-compatible endpoint) --------------------------
# LLM_PROVIDER picks a default base_url preset if QWEN_BASE_URL is unset.
# One of: openrouter, together, fireworks, deepinfra, dashscope, ollama, vllm
LLM_PROVIDER=dashscope
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=qwen2.5-72b-instruct

# --- storage -----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://trader:trader@localhost:5432/trading
REDIS_URL=redis://localhost:6379/0
PARQUET_DIR=./data/parquet
MLFLOW_TRACKING_URI=./mlruns

# --- exchange (TESTNET / SANDBOX ONLY — never put live withdrawal-capable keys here)
EXCHANGE_ID=binance
EXCHANGE_TESTNET=true
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# --- universe ------------------------------------------------------------------
SYMBOLS=["BTC/USDT","ETH/USDT"]

# --- risk limits (hard caps — see app/risk/engine.py) ---------------------------
MAX_POSITION_PCT=0.25
MAX_LEVERAGE=1.0
MAX_DAILY_LOSS_PCT=0.03
MAX_DRAWDOWN_PCT=0.15
MAX_ORDER_NOTIONAL=10000
PRICE_SANITY_BAND_PCT=0.10
KILL_SWITCH=false

# --- monitoring ------------------------------------------------------------------
PROMETHEUS_PORT=9100
LOG_LEVEL=INFO
LOG_DIR=./logs
