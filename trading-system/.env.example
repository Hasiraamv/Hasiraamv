# LLM — pick ONE provider, fill in

# OpenRouter
QWEN_BASE_URL=https://openrouter.ai/api/v1
QWEN_API_KEY=sk-or-xxxxx
QWEN_MODEL=qwen/qwen-2.5-72b-instruct

# Together (alternative)
# QWEN_BASE_URL=https://api.together.xyz/v1
# QWEN_API_KEY=xxxxx
# QWEN_MODEL=Qwen/Qwen2.5-72B-Instruct-Turbo

# Ollama local (alternative)
# QWEN_BASE_URL=http://localhost:11434/v1
# QWEN_API_KEY=ollama
# QWEN_MODEL=qwen2.5:32b

# OpenRouter / Together / Fireworks / DeepInfra / DashScope / Ollama / vLLM base_url
# presets are also available via LLM_PROVIDER instead of setting QWEN_BASE_URL by hand
# — see app/config.py LLM_PROVIDER_BASE_URLS. QWEN_BASE_URL always wins when set.
LLM_PROVIDER=openrouter

# Database
DATABASE_URL=postgresql+psycopg://crypto:crypto@localhost:5432/crypto
REDIS_URL=redis://localhost:6379/0
PARQUET_DIR=./data/parquet
MLFLOW_TRACKING_URI=./mlruns

# Exchange (TESTNET ONLY — no withdrawal permission).
# EXCHANGE is an alias for EXCHANGE_ID (either name works).
EXCHANGE=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_TESTNET=true

# --- universe ------------------------------------------------------------------
SYMBOLS=["BTC/USDT","ETH/USDT"]

# Risk limits (hard caps — see app/risk/engine.py).
# MAX_ORDER_USD is an alias for MAX_ORDER_NOTIONAL (either name works).
MAX_POSITION_PCT=0.02
MAX_LEVERAGE=1
MAX_DAILY_LOSS_PCT=0.02
MAX_DRAWDOWN_PCT=0.15
MAX_ORDER_USD=500
PRICE_SANITY_BAND_PCT=0.10
KILL_SWITCH=false

# Paper mode — TRADING_MODE must be "paper"; this is enforced, not just documented.
TRADING_MODE=paper

# --- monitoring ------------------------------------------------------------------
PROMETHEUS_PORT=9100
LOG_LEVEL=INFO
LOG_DIR=./logs
