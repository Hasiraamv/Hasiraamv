{
  "name": "mintmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mintmark — authenticated import marketplace",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:schema": "wrangler d1 execute mintmark --remote --file=./db/schema.sql",
    "db:seed": "wrangler d1 execute mintmark --remote --file=./db/seed.sql",
    "db:schema:local": "wrangler d1 execute mintmark --local --file=./db/schema.sql",
    "db:seed:local": "wrangler d1 execute mintmark --local --file=./db/seed.sql"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
